# PostgreSQL (port 5433 exposed by docker compose)
POSTGRES_URL=jdbc:postgresql://localhost:5433/glucotwin
POSTGRES_USER=glucotwin
POSTGRES_PASSWORD=glucotwin

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_INTERNAL_TOKEN=dev-internal-token

# JWT (RS256 public key — PEM format, newlines replaced with \n)
JWT_PUBLIC_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# OpenTelemetry
OTLP_METRICS_ENABLED=false
OTLP_ENDPOINT=http://localhost:4317

# Feature flags
TWIN_STALENESS_MINUTES=30
TWIN_STALE_CHECK_INTERVAL_MS=300000
CGM_HISTORY_MAX_SIZE=12
RISK_LOW_MAX=0.30
RISK_MODERATE_MAX=0.60
RISK_HIGH_MAX=0.85
CLINICAL_WARNING_THRESHOLD=20.0

# AI Explanation Layer (optional — disabled by default)
# To enable real LLM explanations: set OPENAI_API_KEY=sk-..., AI_EXPLANATION_ENABLED=true, AI_CHAT_MODEL=openai
AI_EXPLANATION_ENABLED=false
AI_CHAT_MODEL=none
OPENAI_API_KEY=
