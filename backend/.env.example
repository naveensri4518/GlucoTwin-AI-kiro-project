# PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/glucotwin
POSTGRES_USER=glucotwin
POSTGRES_PASSWORD=change-me-in-local-env

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_INTERNAL_TOKEN=change-me-in-local-env

# JWT (RS256 public key — PEM format, newlines replaced with \n)
JWT_PUBLIC_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# OpenTelemetry
OTLP_METRICS_ENABLED=false
OTLP_ENDPOINT=http://localhost:4317

# Feature flags
TWIN_STALENESS_MINUTES=30
TWIN_STALE_CHECK_INTERVAL_MS=300000
CGM_HISTORY_MAX_SIZE=12
RISK_LOW_MAX=0.30
RISK_MODERATE_MAX=0.60
RISK_HIGH_MAX=0.85
CLINICAL_WARNING_THRESHOLD=20.0
